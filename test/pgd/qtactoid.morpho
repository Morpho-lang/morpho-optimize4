
import "../examples/qtactoid.morpho"
import morphoview
import "../show.morpho"

var example = QTactoid()
var adapt = example.build()

var Nlevels = 3

for (n in 1..Nlevels) {
    if (n>1) adapt = example.refine() 

    var control = ProjectedGradientDescentController(adapt)
    control.optimize(1000) 
} 

if (!noVis()) Show(example.visualize())