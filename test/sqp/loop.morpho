// Loop problem solved with SQP

import optimize4 
import plot
import morphoview
import "../show.morpho"
import "../examples/loop.morpho" for LoopExample

var example = LoopExample()
var adapter = example.build()

if (!noVis()) Show(example.visualize())

var control = SQPController(adapter)

control.optimize(500) 

print "lambda:"
print control.ladapter.lagrangeMultipliers()

print control.ladapter.value() 

var K = control.kkt()
print K.eigenvalues() 

if (!noVis()) Show(example.visualize())
