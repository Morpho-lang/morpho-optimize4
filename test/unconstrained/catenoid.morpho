
import plot
import morphoview
import "../show.morpho"

import "../examples/catenoid.morpho"

var sim = CatenoidExample(ratio=0.6) 
sim.initialMesh()
sim.initialSelection()
sim.setupProblem()

var adapt = sim.setupAdapter()
var opt = LBFGSController(adapt)
opt.optimize(1000)

if (!noVis()) Show(sim.visualize())

